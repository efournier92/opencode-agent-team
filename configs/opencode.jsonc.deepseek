{
  "$schema": "https://opencode.ai/config.json",
  // Pure DeepSeek config aligned with the project's opencode.json.sample roster (2026-09-24).
  // Every chat, reasoning, vision, and prose lane runs on the direct DeepSeek API.
  // The single exception is photo-generator: DeepSeek ships zero image-generation
  // models on its direct API (Janus-Pro is open-source only), so that lane stays on
  // google/gemini-3-pro-image.
  //
  // Same 14 agents as the project; reasoningEffort tuning preserved (judgment lanes
  // high, cheap lanes low) to save on reasoning-token output rates.
  //
  // Predecessor (mixed) variant preserved as opencode.jsonc.2026-09-mixed.
  //
  // Install: see ../configs/README.md
  // Swap in:  cp configs/opencode.jsonc.deepseek ~/.config/opencode/opencode.jsonc
  // Revert:   cp configs/opencode.jsonc.2026-09-mixed ~/.config/opencode/opencode.jsonc
  //
  // Model IDs refreshed 2026-09-24 against models.dev. deepseek/deepseek-flash is
  // DeepSeek V4.1 Flash (released 2026-09-10), the current flash model, and it now
  // supports vision natively. It serves the flash chat lanes and the vision lanes.
  // deepseek/deepseek-v4-flash and deepseek/deepseek-v4-flash-vision-exp are
  // deprecated aliases of V4.1 Flash and are retired here. deepseek/deepseek-v4-pro
  // remains the current pro and thinking model; no V4.1 Pro has shipped.
  // Direct DeepSeek pricing: flash $0.15 in / $0.60 out per M tokens, pro $0.435 in
  // / $0.87 out per M. reasoningEffort accepts low, high, or max.
  //
  // Prose: wordsmith runs deepseek/deepseek-v4-pro. DeepSeek's recommendation for
  // prose work is the same chat model with low reasoning effort; reasoningEffort:high
  // is kept from the prior mixed config.
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "chief",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "chief": {
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "high"
    },
    "critic": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "system-fixer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "product-manager": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "builder": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "high"
    },
    "qa": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "compliance-officer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "context-curator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "low"
    },
    "photo-generator": {
      "mode": "subagent",
      "model": "google/gemini-3-pro-image"
    },
    "wordsmith": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "visual-critic": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "low"
    },
    "visual-builder": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "low"
    },
    "scout": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "low"
    },
    "investigator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "low"
    }
  }
}
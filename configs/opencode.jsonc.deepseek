{
  "$schema": "https://opencode.ai/config.json",
  // Pure DeepSeek config aligned with the project's opencode.json.sample roster (2026-09-08).
  // Every chat, reasoning, vision, and prose lane runs on the direct DeepSeek API.
  // The single exception is photo-generator: DeepSeek ships zero image-generation
  // models on its direct API (Janus-Pro is open-source only), so that lane stays on
  // google/gemini-3-pro-image.
  //
  // Same 14 agents as the project; reasoningEffort tuning preserved from the prior
  // mixed config (judgment lanes high, cheap lanes low) to save on reasoning-token
  // output rates (flash $0.66-1.32/M, pro $1.98-3.96/M).
  //
  // Predecessor (mixed) variant preserved as opencode.jsonc.2026-09-mixed.
  //
  // Install: see ../configs/README.md
  // Swap in:  cp configs/opencode.jsonc.deepseek ~/.config/opencode/opencode.jsonc
  // Revert:   cp configs/opencode.jsonc.2026-09-mixed ~/.config/opencode/opencode.jsonc
  //
  // Vision: deepseek/deepseek-v4-flash-vision-exp is the only DeepSeek vision model.
  // It is experimental and flash-tier; using it for visual-critic (the high-effort
  // vision lane) is a quality regression vs openrouter/qwen3.8-max. Traded because
  // the goal here is "all DeepSeek" rather than best-of-breed per lane. If the
  // vision critique output regresses unacceptably, restore the qwen3.8-max lane from
  // opencode.jsonc.2026-09-mixed.
  //
  // Prose: wordsmith moves from openrouter/glm-5.3 (prose-specialist) to
  // deepseek/deepseek-v4-pro. DeepSeek's recommendation for prose work is the same
  // chat model with low reasoning effort, so reasoningEffort:high here follows the
  // prior mixed config. Same trade-off: pure-DepSeek over best-of-breed.
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "chief",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "chief": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high"
    },
    "critic": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "system-fixer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "product-manager": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "builder": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high"
    },
    "qa": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "compliance-officer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "context-curator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "low"
    },
    "photo-generator": {
      "mode": "subagent",
      "model": "google/gemini-3-pro-image"
    },
    "wordsmith": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "visual-critic": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash-vision-exp",
      "reasoningEffort": "low"
    },
    "visual-builder": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash-vision-exp",
      "reasoningEffort": "low"
    },
    "scout": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "low"
    },
    "investigator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "low"
    }
  }
}
{
  "$schema": "https://opencode.ai/config.json",
  // Pure DeepSeek config aligned with the project's opencode.json.sample roster (2026-09-08).
  // Same 14 agents as the project: chief + 7 mid-tier reasoners + photo-generator,
  // wordsmith, visual-critic, visual-builder, scout, investigator. No visual-reviewer
  // (the project's roster dropped it).
  //
  // Add-on vs the shipped sample: per-lane reasoningEffort (DeepSeek API's
  // reasoning_effort: low/high/max). Judgment lanes keep high; cheap lanes run low.
  // Reasoning tokens bill at output rates (flash $0.66-1.32/M, pro $1.98-3.96/M),
  // so low saves ~$1-3/mo plus latency. visual-critic (qwen3.8-max) left untuned:
  // effort param support unverified upstream, and 400s on a 124-call/mo lane are
  // not worth the savings.
  //
  // Install: see ../configs/README.md
  // Swap in:  cp configs/opencode.jsonc.deepseek ~/.config/opencode/opencode.jsonc
  // Revert:   cp configs/opencode.jsonc.deepseek ~/.config/opencode/opencode.jsonc
  //
  // Lanes intentionally NOT from DeepSeek:
  //   - photo-generator: google/gemini-3-pro-image (image generation; no DeepSeek chat model does this).
  //   - wordsmith: openrouter/glm-5.3 (best prose, independent of chat provider).
  //   - visual-critic: openrouter/qwen3.8-max (vision-high tier; DeepSeek has no equivalent vision model).
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "chief",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "chief": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high"
    },
    "critic": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "system-fixer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "product-manager": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "builder": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "high"
    },
    "qa": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "compliance-officer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "high"
    },
    "context-curator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "reasoningEffort": "low"
    },
    "photo-generator": {
      "mode": "subagent",
      "model": "google/gemini-3-pro-image"
    },
    "wordsmith": {
      "mode": "subagent",
      "model": "openrouter/glm-5.3",
      "reasoningEffort": "high"
    },
    "visual-critic": {
      "mode": "subagent",
      "model": "openrouter/qwen3.8-max"
    },
    "visual-builder": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash-vision-exp",
      "reasoningEffort": "low"
    },
    "scout": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "low"
    },
    "investigator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "reasoningEffort": "low"
    }
  }
}
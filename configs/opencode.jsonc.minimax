{
  "$schema": "https://opencode.ai/config.json",
  // Pure MiniMax all-in trial config aligned with the project's opencode.json.sample
  // roster (2026-09-08). Same 14 agents as the project (no visual-reviewer).
  //
  // Requires: MiniMax "Token Plan - Plus" ($22/mo) subscription.
  // Setup: opencode auth login, pick "MiniMax Token Plan", then /models to verify the
  // exact provider slug and model IDs before relying on these strings.
  // photo-generator intentionally stays on google (image generation, not chat).
  //
  // Thinking tuning: reasoningEffort is intentionally NOT set on MiniMax lanes.
  // MiniMax M3 effort-param support is unverified; a 400 would break every call.
  // Validation path: ../configs/opencode.jsonc.deepseek (or a gateway variant) runs
  // the same engine family with reasoningEffort; once one test lane proves low/high
  // works there without a 400, add the same key here (low for scout/investigator/
  // context lanes, high for chief/builder/critic).
  //
  // Install: see ../configs/README.md
  // Swap in:  cp configs/opencode.jsonc.minimax ~/.config/opencode/opencode.jsonc
  // Revert:   cp configs/opencode.jsonc.deepseek ~/.config/opencode/opencode.jsonc
  //
  // Lane mapping:
  //   MiniMax-M3[1m] (1M context, judgment lanes): chief, builder, qa, critic.
  //     Long-context reasoning lanes benefit from the 1M window without paying for it
  //     on short-context subagents.
  //   MiniMax-M3 (200K context, default): system-fixer, product-manager,
  //     compliance-officer, context-curator, visual-critic, visual-builder, wordsmith,
  //     scout.
  //   MiniMax-M2.7-highspeed (cheap, text-only): investigator. Pure locate-and-compress
  //     lane; the highspeed tier is correct.
  "model": "minimax/MiniMax-M3",
  "default_agent": "chief",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "chief": {
      "mode": "primary",
      "model": "minimax/MiniMax-M3[1m]"
    },
    "critic": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3[1m]"
    },
    "system-fixer": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "product-manager": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "builder": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3[1m]"
    },
    "qa": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3[1m]"
    },
    "compliance-officer": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "context-curator": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "photo-generator": {
      "mode": "subagent",
      "model": "google/gemini-3-pro-image"
    },
    "wordsmith": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "visual-critic": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "visual-builder": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "scout": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M3"
    },
    "investigator": {
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.7-highspeed"
    }
  }
}
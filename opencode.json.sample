{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "chief",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "chief": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro"
    },
    "critic": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro"
    },
    "system-fixer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro"
    },
    "product-manager": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro"
    },
    "builder": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro"
    },
    "qa": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro"
    },
    "compliance-officer": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro"
    },
    "context-curator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro"
    },
    "photo-generator": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3-pro-image"
    },
    "wordsmith": {
      "mode": "subagent",
      "model": "opencode-go/glm-5.3"
    },
    "visual-critic": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.8-max"
    },
    "visual-builder": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "scout": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash"
    },
    "investigator": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash"
    }
  }
}

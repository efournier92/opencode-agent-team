{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "default_agent": "chief",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "chief": {
      "mode": "primary",
      "model": "anthropic/claude-opus-5"
    },
    "critic": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5"
    },
    "system-fixer": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5"
    },
    "product-manager": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5"
    },
    "builder": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5"
    },
    "qa": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5"
    },
    "compliance-officer": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5"
    },
    "context-curator": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5"
    },
    "scout": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5"
    },
    "investigator": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5"
    }
  }
}
